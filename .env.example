# Public browser configuration. Vite exposes VITE_* values in the client bundle,
# so never put credentials or secrets in these variables.
VITE_API_BASE_URL=http://localhost:8787
VITE_WS_BASE_URL=ws://localhost:8787

# Server-only local variables belong in .dev.vars when the Worker is introduced.
# Production deployment values must be configured as GitHub environment secrets
# or Cloudflare secrets, never committed here.
